QWidget#CardWidget {
    background-color: #FFFFFF;
    border-radius: 20px;
    border: 1px solid #D9D9D9;
}

QLabel#CardTitleLabel {
    color: #203532;
    font-size: 16px;
    font-weight: bold;
}
 
QLabel#ScreenshotPreviewLabel {
    border: 2px solid #CCCCCC;
    border-radius: 10px;
    background-color: #FFFFFF; 
    alignment: 'AlignCenter'; 
}

QLabel#ScreenshotPreviewLabel:hover {
    border: 2px solid #4A90E2; 
}