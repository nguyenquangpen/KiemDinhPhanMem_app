/* ==========================================================================
   Cards & sections
   ========================================================================== */

QFrame#Card,
QWidget#CardWidget {
    background-color: #FFFFFF;
    border: 1px solid #E3E5E5;
    border-radius: 8px;
}

QFrame#SubtleCard {
    background-color: #F9FAFA;
    border: 1px solid #E3E5E5;
    border-radius: 8px;
}

QWidget#Section {
    background: transparent;
}
QWidget#SectionBottomLine {
    background: transparent;
    border-bottom: 1px solid #E3E5E5;
}
QWidget#SectionRightLine {
    background: transparent;
    border-right: 1px solid #E3E5E5;
}

QLabel#CardTitleLabel {
    color: #1E2B29;
    font-size: 15px;
    font-weight: 600;
}

/* --- Sidebar --- */
QWidget#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E3E5E5;
}
QLabel#BrandName {
    font-size: 15px;
    font-weight: 600;
}
QLabel#BrandCaption {
    font-size: 11px;
    color: #5B6866;
}
QLabel#BrandMark {
    background-color: #2F8A55;
    border-radius: 8px;
}

QPushButton#NavItem,
QPushButton#NavSubItem {
    background: transparent;
    border: none;
    border-radius: 8px;
    text-align: left;
    color: #1E2B29;
    font-size: 13px;
    font-weight: 500;
    padding: 9px 12px;
}
QPushButton#NavSubItem {
    color: #5B6866;
    font-weight: 400;
    padding: 7px 12px;
    border-radius: 6px;
}
QPushButton#NavItem:hover,
QPushButton#NavSubItem:hover {
    background-color: #F5F6F6;
}
QPushButton#NavItem:checked,
QPushButton#NavSubItem:checked {
    background-color: #EAF5EE;
    color: #226B41;
}
QPushButton#NavSubItem:checked {
    font-weight: 600;
}
QWidget#NavSubGroup {
    border-left: 1px solid #E3E5E5;
}

QFrame#ProjectCard {
    background-color: #FFFFFF;
    border: 1px solid #E3E5E5;
    border-radius: 8px;
}
QWidget#ProjectCardHead {
    border-bottom: 1px dashed #D3D7D6;
}
QLabel#ProjectCardKey {
    font-family: "Noto Serif";
    font-size: 11px;
    color: #5B6866;
}
QLabel#ProjectCardValue {
    font-family: "Noto Serif";
    font-size: 11px;
    color: #1E2B29;
}

QLabel#Avatar {
    background-color: #EAF5EE;
    color: #226B41;
    border-radius: 16px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#UserName {
    font-size: 13px;
    font-weight: 500;
}
QLabel#SyncState {
    font-size: 11px;
    color: #226B41;
}
QWidget#SidebarFooter {
    border-top: 1px solid #E3E5E5;
}

/* --- Screenshot thumbnails --- */
QLabel#ScreenshotPreviewLabel {
    border: 1px solid #E3E5E5;
    border-radius: 8px;
    background-color: #FFFFFF;
}
QLabel#ScreenshotPreviewLabel:hover {
    border: 2px solid #2E6DB4;
}
QLabel#ScreenshotPreviewLabel[error="true"] {
    background-color: #FCEDEC;
    border: 1px solid #E3C4C1;
    color: #9E2F27;
}
