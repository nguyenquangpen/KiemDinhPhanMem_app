QLineEdit, 
QComboBox {
    background-color: #FFFFFF; 
    padding: 5px 8px;
    border: 1px solid #D9D9D9; 
    border-radius: 5px;
    min-height: 24px;
    color: #203532; 
}

QLineEdit:focus, 
QComboBox:focus {
    border: 1px solid #4A90E2;
}

QLabel#form-label {
    font-weight: 500;
    font-size: 13px;
    margin-bottom: 2px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 3px;
}
QCheckBox::indicator:unchecked {
    border: 2px solid #CCCCCC;
    background-color: #FFFFFF; 
}
QCheckBox::indicator:checked {
    border: 2px solid #4A90E2;
    background-color: #4A90E2; 
}

QLabel#ErrorLabel {
    color: #F48080;
    font-weight: bold;
    font-size: 14pt;
    border: 1px solid #F48080;
}

QLineEdit#EditingCellLineEdit {
    background-color: #FFFFFF; 
    border: 1px solid #4A90E2;
    padding: 3px;
    border-radius: 5px;
}

QLineEdit#SearchLineEdit {
    background-color: #FFFFFF; 
    border-radius: 15px;           
    min-height: 30px;        
}

QPushButton#NewProjectButton {
    background-color: #56BB55; 
    color: #FFFFFF;            
    border: none;
    border-radius: 8px;      
    font-weight: bold;        
}

QPushButton#NewProjectButton:hover {
    background-color: #4CAA4C;
}
