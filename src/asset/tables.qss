/* ==========================================================================
   DataTableWidget (views/components/table.py)
   The table sits in a white card: header, zebra rows, pagination footer.
   ========================================================================== */

QWidget#DataTable {
    background-color: #FFFFFF;
    border: 1px solid #E3E5E5;
    border-radius: 8px;
}

QWidget#DataTableHeader {
    background-color: #FFFFFF;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

#TableHeader,
#TableHeaderFirst,
#TableHeaderLast {
    background-color: #FFFFFF;
    color: #1E2B29;
    font-size: 12px;
    font-weight: 600;
    padding: 0 10px;
    min-height: 44px;
    border-bottom: 1px solid #E3E5E5;
}
#TableHeaderFirst {
    border-top-left-radius: 8px;
}
#TableHeaderLast {
    border-top-right-radius: 8px;
}

QWidget#DataTableBody {
    background-color: #FFFFFF;
}

/* --- Rows --- */
QWidget#RowEven {
    background-color: #FFFFFF;
    border-bottom: 1px solid #ECEEEE;
}
QWidget#RowOdd {
    background-color: #FAFAFA;
    border-bottom: 1px solid #ECEEEE;
}
QWidget#SelectedRow {
    background-color: #F1F8F4;
    border-bottom: 1px solid #DCEDE2;
}

/* Plain cell text (EditableCell / base cells set this object name) */
QLabel#CellText {
    font-family: "Noto Serif";
    font-size: 13px;
}

/* Status colours (set with DataTableWidget.set_row_color) */
QWidget#RowColor_green {
    background-color: #F1F8F4;
    border-bottom: 1px solid #DCEDE2;
}
QWidget#RowColor_red {
    background-color: #FDF4F3;
    border-bottom: 1px solid #F3DEDC;
}
QWidget#RowColor_blue {
    background-color: #F1F7FD;
    border-bottom: 1px solid #DCE8F5;
}
QWidget#RowColor_yellow {
    background-color: #FFFAF0;
    border-bottom: 1px solid #F4E6C8;
}
QWidget#RowColor_white {
    background-color: #FFFFFF;
    border-bottom: 1px solid #ECEEEE;
}
QWidget#RowColor_off_white {
    background-color: #FAFAFA;
    border-bottom: 1px solid #ECEEEE;
}

QWidget#RowRunning { background-color: #FFFAF0; }
QWidget#RowPassed  { background-color: #F1F8F4; }
QWidget#RowFailed,
QWidget#RowError   { background-color: #FDF4F3; }

/* --- Special cells --- */
QLabel[class="projectName"] {
    font-family: "Poppins";
    font-weight: 500;
    color: #1E2B29;
}
QLabel[class="projectName"]:hover {
    color: #1F4F86;
}

QLabel[class="ngCount"][has_ng="true"] {
    color: #9E2F27;
    font-weight: 600;
}

QLabel#NumberPositive,
QLabel#NumberNegative {
    font-weight: 500;
}
QLabel#NumberNegative {
    color: #9E2F27;
}

QLabel#CellStrong {
    font-family: "Poppins";
    font-weight: 500;
    font-size: 13px;
}

/* --- Footer --- */
#pagination-container {
    background-color: #FFFFFF;
    border-top: 1px solid #E3E5E5;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
QLabel#PaginationInfo {
    font-family: "Noto Serif";
    font-size: 12px;
    color: #5B6866;
}

QWidget#CalculationWidget {
    background-color: #FAFAFA;
    border-top: 1px solid #E3E5E5;
}
QLabel#CalculationLabel {
    color: #1F4F86;
    padding: 2px;
    font-weight: 600;
}

/* --- Legacy QTableWidget used by some dialogs --- */
QTableWidget#testcase-table::item {
    padding: 8px;
}
QTableWidget#testcase-table::item:selected {
    background-color: #F1F8F4;
    color: #1E2B29;
}
