/* ==========================================================================
   Buttons
   primary   (green fill)        : the one main action of an area
   secondary (blue outline/soft) : open / view / navigate
   neutral   (white outline)     : everything else
   danger    (red outline)       : destructive
   Legacy object names are mapped onto these variants:
     GreenButton / NewProjectButton -> primary
     BlueButton                     -> secondary
     GrayButton / YellowButton      -> neutral
     RedButton / DefaultDeleteButton-> danger
   ========================================================================== */

QPushButton {
    background-color: #FFFFFF;
    color: #1E2B29;
    border: 1px solid #D3D7D6;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 500;
    min-height: 20px;
}
QPushButton:hover {
    background-color: #F5F6F6;
}
QPushButton:pressed {
    background-color: #EEF0F0;
}
QPushButton:disabled {
    background-color: #EEF0F0;
    color: #8A9593;
    border-color: #E3E5E5;
}
QPushButton:focus {
    outline: none;
}

/* --- Primary --- */
QPushButton#PrimaryButton,
QPushButton#GreenButton,
QPushButton#NewProjectButton,
QPushButton#add-row-button {
    background-color: #2F8A55;
    color: #FFFFFF;
    border: 1px solid #2F8A55;
}
QPushButton#PrimaryButton:hover,
QPushButton#GreenButton:hover,
QPushButton#NewProjectButton:hover,
QPushButton#add-row-button:hover {
    background-color: #277449;
    border-color: #277449;
}
QPushButton#PrimaryButton:disabled,
QPushButton#GreenButton:disabled,
QPushButton#NewProjectButton:disabled {
    background-color: #EEF0F0;
    color: #8A9593;
    border-color: #E3E5E5;
}

/* --- Secondary --- */
QPushButton#SecondaryButton,
QPushButton#BlueButton {
    background-color: #F1F7FD;
    color: #1F4F86;
    border: 1px solid #2E6DB4;
    font-weight: 600;
}
QPushButton#SecondaryButton:hover,
QPushButton#BlueButton:hover {
    background-color: #E2EEFA;
}
QPushButton#SecondaryButton:disabled,
QPushButton#BlueButton:disabled {
    background-color: #EEF0F0;
    color: #8A9593;
    border-color: #E3E5E5;
}

/* --- Neutral --- */
QPushButton#NeutralButton,
QPushButton#GrayButton,
QPushButton#YellowButton {
    background-color: #FFFFFF;
    color: #1E2B29;
    border: 1px solid #D3D7D6;
}
QPushButton#NeutralButton:hover,
QPushButton#GrayButton:hover,
QPushButton#YellowButton:hover {
    background-color: #F5F6F6;
}

/* --- Danger --- */
QPushButton#DangerButton,
QPushButton#RedButton,
QPushButton#DefaultDeleteButton {
    background-color: #FFFFFF;
    color: #9E2F27;
    border: 1px solid #E3C4C1;
}
QPushButton#DangerButton:hover,
QPushButton#RedButton:hover,
QPushButton#DefaultDeleteButton:hover {
    background-color: #FCEDEC;
}
QPushButton#DangerButton:disabled,
QPushButton#RedButton:disabled {
    background-color: #EEF0F0;
    color: #8A9593;
    border-color: #E3E5E5;
}

QPushButton#GhostDangerButton {
    background: transparent;
    border: none;
    color: #9E2F27;
}
QPushButton#GhostDangerButton:hover {
    background-color: #FCEDEC;
}
QPushButton#GhostDangerButton:disabled {
    background: transparent;
    color: #8A9593;
}

/* --- Sizes --- */
QPushButton[size="normal"] {
    padding: 9px 16px;
    font-size: 12px;
}
QPushButton[size="small"] {
    padding: 5px 10px;
    font-size: 11px;
}

/* --- Square icon buttons (row actions) --- */
QPushButton#IconButton {
    background-color: #FFFFFF;
    border: 1px solid #E3E5E5;
    border-radius: 6px;
    padding: 0px;
    min-height: 30px;
    max-height: 30px;
}
QPushButton#IconButton:hover {
    background-color: #F5F6F6;
    border-color: #D3D7D6;
}
QPushButton#IconButton[danger="true"]:hover {
    background-color: #FCEDEC;
    border-color: #E3C4C1;
}

/* --- Segmented filter --- */
QPushButton#SegmentButton {
    background-color: #FFFFFF;
    color: #1E2B29;
    border: 1px solid #D3D7D6;
    border-radius: 0px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 500;
    margin-left: -1px;
}
QPushButton#SegmentButton[pos="first"] {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    margin-left: 0px;
}
QPushButton#SegmentButton[pos="last"] {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}
QPushButton#SegmentButton:checked {
    background-color: #1E2B29;
    color: #FFFFFF;
    border-color: #1E2B29;
}

/* --- Pagination --- */
QPushButton#PageNavButton,
QPushButton#PageButton {
    background-color: #FFFFFF;
    color: #1E2B29;
    border: 1px solid #E3E5E5;
    border-radius: 6px;
    padding: 0px 10px;
    min-height: 30px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#PageButton {
    padding: 0px;
}
QPushButton#PageNavButton:hover,
QPushButton#PageButton:hover {
    background-color: #F5F6F6;
}
QPushButton#PageNavButton:disabled {
    background-color: #FFFFFF;
    color: #B7BFBD;
    border-color: #ECEEEE;
}
QPushButton#ActivePageButton {
    background-color: #2F8A55;
    color: #FFFFFF;
    border: 1px solid #2F8A55;
    border-radius: 6px;
    padding: 0px;
    font-size: 12px;
    font-weight: 600;
}

/* --- Sidebar footer buttons --- */
QPushButton#SidebarIconButton {
    background-color: #FFFFFF;
    border: 1px solid #E3E5E5;
    border-radius: 6px;
    padding: 0px;
    min-height: 0px;
}
QPushButton#SidebarIconButton:hover {
    background-color: #F5F6F6;
}

QPushButton#LinkButton {
    background: transparent;
    border: none;
    padding: 0px;
    color: #1F4F86;
    font-weight: 600;
    text-align: left;
}
QPushButton#LinkButton:hover {
    color: #2E6DB4;
    text-decoration: underline;
}
